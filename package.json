{
  "name": "throttle-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static front-end for throttle.toys",
  "scripts": {
    "dev": "vite --port 8000 --open",
    "serve": "python3 -m http.server 8000",
    "lint": "npm run lint:html && npm run lint:css",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**\"",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore || true",
    "links": "lychee --no-progress --max-redirects 5 --exclude-mail './**/*.html'"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "htmlhint": "^1.1.4",
    "stylelint": "^17.14.0",
    "vite": "^5.4.0"
  }
}
